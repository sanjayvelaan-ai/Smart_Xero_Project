# Leave DATABASE_URL empty for the single-process local demo with embedded PostgreSQL.
# DATABASE_URL=postgresql://printflow:local-development-only@localhost:5433/printflow
# PRINTFLOW_DATA_DIR=.printflow

# Set an HTTPS public origin for the live shop and secure cookies.
# PRINTFLOW_PUBLIC_ORIGIN=https://print.example.com
# Enable only behind a trusted reverse proxy that rewrites forwarded headers.
# PRINTFLOW_TRUST_PROXY=true

# Configure a separate live shop at /shop/velachery and /owner?shop=velachery.
# PRINTFLOW_OWNER_PASSWORD=
# PRINTFLOW_WORKER_PASSWORD=
# PRINTFLOW_SECOND_WORKER_PASSWORD=
# PRINTFLOW_DOCUMENT_KEY=

# Optional live payment integration.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
